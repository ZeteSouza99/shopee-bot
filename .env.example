# Variáveis de ambiente para deploy em nuvem
# Copie este arquivo para .env e preencha os valores

# Flask
FLASK_SECRET_KEY=gere-uma-chave-secreta-forte-aqui
FLASK_DEBUG=false

# Banco de dados (deixe vazio para usar SQLite local)
# Para PostgreSQL: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Evolution API (WhatsApp) - opcional
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=shopee-evolution-key

# Porta do servidor (Railway/Render definem automaticamente)
PORT=5000
